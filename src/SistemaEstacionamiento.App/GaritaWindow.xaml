<Window x:Class="SistemaEstacionamiento.App.GaritaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garita - Cobro y Asignación" Height="650" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Garita de Cobro"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Tipo de vehículo -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Tipo de vehículo:" VerticalAlignment="Center" Width="150"/>
            <ComboBox ItemsSource="{Binding Sectores}"
                      SelectedItem="{Binding SectorSeleccionado}"
                      Width="200" Padding="5"/>
        </StackPanel>

        <!-- DNI (obligatorio) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="DNI (obligatorio):" VerticalAlignment="Center" Width="150"/>
            <TextBox Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Padding="5" MaxLength="10"/>
            <TextBlock Text="  (7 u 8 dígitos, sin puntos)"
                       VerticalAlignment="Center" FontStyle="Italic"
                       Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Patente (opcional) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Patente (opcional):" VerticalAlignment="Center" Width="150"/>
            <TextBox Text="{Binding Patente, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Padding="5" CharacterCasing="Upper"/>
        </StackPanel>

        <!-- Precio -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Precio:" VerticalAlignment="Center" Width="150"/>
            <TextBox Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Padding="5"/>
        </StackPanel>

        <!-- Método de pago -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Método de pago:" VerticalAlignment="Center" Width="150"/>
            <ComboBox ItemsSource="{Binding MetodosPago}"
                      SelectedItem="{Binding MetodoPago}"
                      Width="200" Padding="5"/>
        </StackPanel>

        <!-- Operador -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Operador:" VerticalAlignment="Center" Width="150"/>
            <TextBox Text="{Binding Operador, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Padding="5"/>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,15">
            <Button Content="💵 COBRAR Y ASIGNAR LUGAR"
                    Command="{Binding CobrarCommand}"
                    IsEnabled="{Binding PuedeCobrar}"
                    FontSize="18" FontWeight="Bold" Height="60" Width="300"
                    Background="LightGreen" Margin="0,0,15,0"/>

            <Button Content="🔄 NUEVO COBRO"
                    Command="{Binding NuevoCobroCommand}"
                    FontSize="16" FontWeight="Bold" Height="60" Width="200"
                    Background="LightYellow"
                    Visibility="{Binding CobroExitoso, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <!-- Resultado -->
        <StackPanel Grid.Row="8">
            <TextBlock Text="{Binding Mensaje}"
                       FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="DarkGreen" Margin="0,0,0,10"/>
            <Border BorderBrush="Black" BorderThickness="2"
                    Padding="15" Background="LightYellow"
                    Visibility="{Binding CobroExitoso, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="LUGAR ASIGNADO:" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LugarAsignado}"
                               FontSize="48" FontWeight="Bold"
                               Foreground="DarkRed" HorizontalAlignment="Center"/>
                    <TextBlock Text="Mostrar al acomodador"
                               FontSize="12" HorizontalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>